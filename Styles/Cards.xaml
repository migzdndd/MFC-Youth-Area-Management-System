<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Base Card Style (Preserving existing Card key for backward compatibility) -->
    <Style TargetType="Border" x:Key="Card">
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="Margin" Value="6" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushApp}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#1E293B"
                                  BlurRadius="10"
                                  Opacity="0.04"
                                  ShadowDepth="2"
                                  Direction="270" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Compact Card Style -->
    <Style TargetType="Border" x:Key="CompactCard" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="12" />
        <Setter Property="Margin" Value="4" />
    </Style>

    <!-- Stat Card Style -->
    <Style TargetType="Border" x:Key="StatCard">
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="18,16" />
        <Setter Property="Margin" Value="6" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushApp}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#1E293B"
                                  BlurRadius="8"
                                  Opacity="0.04"
                                  ShadowDepth="1"
                                  Direction="270" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Header / Banner Card Style -->
    <Style TargetType="Border" x:Key="HeaderBannerCard">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#132A4A" Offset="0.0" />
                    <GradientStop Color="#0D1F38" Offset="1.0" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="24,20" />
        <Setter Property="Margin" Value="6,4,6,12" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#0D1F38"
                                  BlurRadius="12"
                                  Opacity="0.12"
                                  ShadowDepth="3"
                                  Direction="270" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Trend Card Style -->
    <Style TargetType="Border" x:Key="TrendCard">
        <Setter Property="Background" Value="{StaticResource NavySoft}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Margin" Value="6,4,6,8" />
        <Setter Property="BorderBrush" Value="#C7D7EC" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Status Badges -->
    <Style TargetType="Border" x:Key="BadgeActive">
        <Setter Property="Background" Value="{StaticResource SuccessSoft}" />
        <Setter Property="BorderBrush" Value="{StaticResource SuccessBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style TargetType="Border" x:Key="BadgeInactive">
        <Setter Property="Background" Value="#F1F5F9" />
        <Setter Property="BorderBrush" Value="#CBD5E1" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style TargetType="Border" x:Key="BadgeGold">
        <Setter Property="Background" Value="{StaticResource GoldSoft}" />
        <Setter Property="BorderBrush" Value="{StaticResource GoldLight}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style TargetType="Border" x:Key="BadgeNavy">
        <Setter Property="Background" Value="{StaticResource NavySoft}" />
        <Setter Property="BorderBrush" Value="#CBD5E1" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

</ResourceDictionary>
