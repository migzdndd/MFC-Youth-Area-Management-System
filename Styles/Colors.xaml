<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Raw Colors -->
    <Color x:Key="NavyColor">#132A4A</Color>
    <Color x:Key="NavyDarkColor">#0D1F38</Color>
    <Color x:Key="NavyMediumColor">#1E3A60</Color>
    <Color x:Key="NavyLightColor">#2D4F7C</Color>
    <Color x:Key="NavySoftColor">#EBF1F8</Color>

    <Color x:Key="GoldColor">#F3B61F</Color>
    <Color x:Key="GoldDarkColor">#D49A0D</Color>
    <Color x:Key="GoldLightColor">#FDE8B5</Color>
    <Color x:Key="GoldSoftColor">#FFF8E7</Color>

    <Color x:Key="PageBackgroundColor">#F5F7FA</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceSubtleColor">#F8FAFC</Color>

    <Color x:Key="BorderColor">#DFE4EA</Color>
    <Color x:Key="BorderFocusColor">#2563EB</Color>
    <Color x:Key="BorderSubtleColor">#E2E8F0</Color>

    <Color x:Key="TextPrimaryColor">#18202A</Color>
    <Color x:Key="TextSecondaryColor">#475569</Color>
    <Color x:Key="TextMutedColor">#657080</Color>
    <Color x:Key="TextLightColor">#FFFFFF</Color>
    <Color x:Key="TextLightMutedColor">#94A3B8</Color>

    <Color x:Key="ActionBlueColor">#2563EB</Color>
    <Color x:Key="ActionBlueHoverColor">#1D4ED8</Color>
    <Color x:Key="ActionBlueSoftColor">#EFF6FF</Color>

    <Color x:Key="DangerColor">#DC2626</Color>
    <Color x:Key="DangerHoverColor">#B91C1C</Color>
    <Color x:Key="DangerSoftColor">#FEF2F2</Color>
    <Color x:Key="DangerBorderColor">#FECACA</Color>

    <Color x:Key="SuccessColor">#16A34A</Color>
    <Color x:Key="SuccessHoverColor">#15803D</Color>
    <Color x:Key="SuccessSoftColor">#F0FDF4</Color>
    <Color x:Key="SuccessBorderColor">#BBF7D0</Color>

    <Color x:Key="WarningColor">#D97706</Color>
    <Color x:Key="WarningSoftColor">#FFFBEB</Color>
    <Color x:Key="WarningBorderColor">#FDE68A</Color>

    <!-- SolidColorBrushes (Preserving existing exact keys Navy, NavyDark, Gold, PageBackground, Surface, BorderBrushApp, TextPrimary, TextMuted, Danger, ActionBlue) -->
    <SolidColorBrush x:Key="Navy" Color="{StaticResource NavyColor}" />
    <SolidColorBrush x:Key="NavyDark" Color="{StaticResource NavyDarkColor}" />
    <SolidColorBrush x:Key="NavyMedium" Color="{StaticResource NavyMediumColor}" />
    <SolidColorBrush x:Key="NavyLight" Color="{StaticResource NavyLightColor}" />
    <SolidColorBrush x:Key="NavySoft" Color="{StaticResource NavySoftColor}" />

    <SolidColorBrush x:Key="Gold" Color="{StaticResource GoldColor}" />
    <SolidColorBrush x:Key="GoldDark" Color="{StaticResource GoldDarkColor}" />
    <SolidColorBrush x:Key="GoldLight" Color="{StaticResource GoldLightColor}" />
    <SolidColorBrush x:Key="GoldSoft" Color="{StaticResource GoldSoftColor}" />

    <SolidColorBrush x:Key="PageBackground" Color="{StaticResource PageBackgroundColor}" />
    <SolidColorBrush x:Key="Surface" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceSubtle" Color="{StaticResource SurfaceSubtleColor}" />

    <SolidColorBrush x:Key="BorderBrushApp" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderBrushFocus" Color="{StaticResource BorderFocusColor}" />
    <SolidColorBrush x:Key="BorderSubtle" Color="{StaticResource BorderSubtleColor}" />

    <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMuted" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="TextLight" Color="{StaticResource TextLightColor}" />
    <SolidColorBrush x:Key="TextLightMuted" Color="{StaticResource TextLightMutedColor}" />

    <SolidColorBrush x:Key="ActionBlue" Color="{StaticResource ActionBlueColor}" />
    <SolidColorBrush x:Key="ActionBlueHover" Color="{StaticResource ActionBlueHoverColor}" />
    <SolidColorBrush x:Key="ActionBlueSoft" Color="{StaticResource ActionBlueSoftColor}" />

    <SolidColorBrush x:Key="Danger" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerHover" Color="{StaticResource DangerHoverColor}" />
    <SolidColorBrush x:Key="DangerSoft" Color="{StaticResource DangerSoftColor}" />
    <SolidColorBrush x:Key="DangerBorder" Color="{StaticResource DangerBorderColor}" />

    <SolidColorBrush x:Key="Success" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessHover" Color="{StaticResource SuccessHoverColor}" />
    <SolidColorBrush x:Key="SuccessSoft" Color="{StaticResource SuccessSoftColor}" />
    <SolidColorBrush x:Key="SuccessBorder" Color="{StaticResource SuccessBorderColor}" />

    <SolidColorBrush x:Key="Warning" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="WarningSoft" Color="{StaticResource WarningSoftColor}" />
    <SolidColorBrush x:Key="WarningBorder" Color="{StaticResource WarningBorderColor}" />

    <SolidColorBrush x:Key="HoverBackground" Color="#F1F5F9" />
    <SolidColorBrush x:Key="SelectedBackground" Color="#E0E9F4" />
    <SolidColorBrush x:Key="SidebarHover" Color="#1B3A63" />
    <SolidColorBrush x:Key="SidebarActive" Color="#1E4373" />
</ResourceDictionary>
