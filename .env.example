# ===================================================
# MFC Youth AMS - Environment Variables Template
# ===================================================
# Copy this file to .env or .env.local for development.
# Client-side variables (used by Vite, Capacitor, and Desktop) MUST start with VITE_

# [LIVE SUPABASE CONFIGURATION]
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server / Backend variables (used by Backend/ dev-server & Vercel serverless)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Servant Leader Registration Access Code
ADMIN_REGISTRATION_CODE=CHANGE_THIS_TO_A_PRIVATE_CODE
