<Application x:Class="MFCYouthAreaManagementSystem.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MFCYouthAreaManagementSystem.Views"
             xmlns:viewmodels="clr-namespace:MFCYouthAreaManagementSystem.ViewModels"
             xmlns:converters="clr-namespace:MFCYouthAreaManagementSystem.Utilities.Converters"
             Startup="Application_Startup">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Global Converters -->
            <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
            <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
            <converters:EmptyCollectionToVisibilityConverter x:Key="EmptyToVis" />
            <converters:HasItemsToVisibilityConverter x:Key="HasItemsToVis" />
            <converters:StatusToForegroundConverter x:Key="StatusToFg" />
            <converters:StatusToBackgroundConverter x:Key="StatusToBg" />
            <converters:StatusToBorderConverter x:Key="StatusToBorder" />

            <!-- ViewModel to View Mappings -->
            <DataTemplate DataType="{x:Type viewmodels:DashboardHomeViewModel}">
                <views:DashboardHomeView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:MembersViewModel}">
                <views:MembersView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:ChaptersViewModel}">
                <views:ChaptersView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:EventsViewModel}">
                <views:EventsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:ServicesViewModel}">
                <views:ServicesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:ReportsViewModel}">
                <views:ReportsView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
