<UserControl x:Class="MFCYouthAreaManagementSystem.Views.MembersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:MFCYouthAreaManagementSystem.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewmodels:MembersViewModel}">

    <UserControl.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding AddMemberCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="Delete" Command="{Binding DeleteMemberCommand}" />
        <KeyBinding Key="Enter" Command="{Binding ViewMemberCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page Header & Action Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Members" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Manage member directories, chapter assignments, service roles, and GIG contribution records."
                           Style="{StaticResource PageSubtitle}" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Primary Action Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="+ Add Member"
                        Command="{Binding AddMemberCommand}"
                        Style="{StaticResource PrimaryButton}" />
            </StackPanel>
        </Grid>

        <!-- Toolbar: Filters + Context Actions -->
        <Border Grid.Row="1" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource BorderBrushApp}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,10"
                Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Search Input -->
                    <TextBox Width="220"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,8,0"
                             ToolTip="Search members by name or contact..." />

                    <!-- Status Filter -->
                    <ComboBox Width="140"
                              ItemsSource="{Binding Statuses}"
                              SelectedItem="{Binding SelectedStatus}"
                              Margin="0,0,8,0" />

                    <!-- Chapter Filter -->
                    <ComboBox Width="190"
                              ItemsSource="{Binding Chapters}"
                              DisplayMemberPath="ChapterName"
                              SelectedItem="{Binding SelectedChapter}"
                              Margin="0,0,8,0" />

                    <!-- Clear Button -->
                    <Button Content="Clear Filters"
                            Command="{Binding ClearFiltersCommand}"
                            Style="{StaticResource GhostButton}"
                            Margin="0,0,12,0" />

                    <!-- Action Buttons -->
                    <Border BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1,0,0,0" Margin="4,0,8,0" Height="24" />

                    <Button Content="View Details"
                            Command="{Binding ViewMemberCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Padding="12,6" />

                    <Button Content="Edit"
                            Command="{Binding EditMemberCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Padding="12,6" />

                    <Button Content="Assign Services"
                            Command="{Binding AssignServicesCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Padding="12,6" />

                    <Button Content="GIG Tracker"
                            Command="{Binding GigCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Padding="12,6" />

                    <Button Content="Delete"
                            Command="{Binding DeleteMemberCommand}"
                            Style="{StaticResource DangerButton}"
                            Padding="12,6" />

                    <Button Command="{Binding RefreshCommand}"
                            Style="{StaticResource IconButton}"
                            ToolTip="Refresh list (F5)">
                        <Path Data="{StaticResource GeoRefresh}" Fill="{StaticResource TextSecondary}" Stretch="Uniform" Width="14" Height="14" />
                    </Button>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- Members DataGrid with Empty State -->
        <Grid Grid.Row="2">
            <DataGrid ItemsSource="{Binding Members}"
                      SelectedItem="{Binding SelectedMember}"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <!-- Full Name -->
                    <DataGridTemplateColumn Header="Member Name" Width="2*" SortMemberPath="FullName">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Chapter -->
                    <DataGridTextColumn Header="Chapter" Binding="{Binding ChapterName}" Width="*" />

                    <!-- Status Pill -->
                    <DataGridTemplateColumn Header="Status" Width="110" SortMemberPath="Status">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding Status, Converter={StaticResource StatusToBg}}"
                                        BorderBrush="{Binding Status, Converter={StaticResource StatusToBorder}}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="8,2"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Status}"
                                               Foreground="{Binding Status, Converter={StaticResource StatusToFg}}"
                                               FontSize="11"
                                               FontWeight="SemiBold" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Services -->
                    <DataGridTextColumn Header="Assigned Services" Binding="{Binding Services}" Width="2*" />

                    <!-- Contact -->
                    <DataGridTextColumn Header="Contact Number" Binding="{Binding ContactNumber}" Width="130" />

                    <!-- Email -->
                    <DataGridTextColumn Header="Email Address" Binding="{Binding EmailAddress}" Width="180" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- Empty State Overlay -->
            <Border Visibility="{Binding Members, Converter={StaticResource EmptyToVis}}"
                    Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource BorderBrushApp}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <Border Width="52" Height="52" CornerRadius="26" Background="{StaticResource NavySoft}" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <Path Data="{StaticResource GeoMembers}" Fill="{StaticResource Navy}" Stretch="Uniform" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="No Members Found" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Navy}" HorizontalAlignment="Center" Margin="0,0,0,4" />
                    <TextBlock Text="No member records match your current search and filter settings." Foreground="{StaticResource TextMuted}" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,14" />
                    <Button Content="Clear Filters" Command="{Binding ClearFiltersCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl>
