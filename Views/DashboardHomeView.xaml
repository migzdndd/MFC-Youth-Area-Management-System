<UserControl x:Class="MFCYouthAreaManagementSystem.Views.DashboardHomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:MFCYouthAreaManagementSystem.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewmodels:DashboardHomeViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24">

            <!-- Page Header -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Area Dashboard" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Real-time operational summary and activity metrics for MFC Youth NCR Central."
                               Style="{StaticResource PageSubtitle}" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>

            <!-- 8 Reflowing Stat Cards -->
            <WrapPanel Margin="-6,0,-6,12" Orientation="Horizontal">

                <!-- 1. Total Members -->
                <Border Style="{StaticResource StatCard}" Width="215" MinWidth="190">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="TOTAL MEMBERS" Style="{StaticResource CardLabel}" />
                            <TextBlock Text="{Binding TotalMembers}" Style="{StaticResource MetricValue}" />
                            <TextBlock Text="Registered across chapters" Style="{StaticResource MetricSubtext}" />
                        </StackPanel>
                        <Border Grid.Column="1" Width="40" Height="40" CornerRadius="8" Background="{StaticResource ActionBlueSoft}" VerticalAlignment="Top">
                            <Path Data="{StaticResource GeoMembers}" Fill="{StaticResource ActionBlue}" Stretch="Uniform" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>

                <!-- 2. Active Members -->
                <Border Style="{StaticResource StatCard}" Width="215" MinWidth="190">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="ACTIVE MEMBERS" Style="{StaticResource CardLabel}" />
                            <TextBlock Text="{Binding ActiveMembers}" Style="{StaticResource MetricValue}" Foreground="{StaticResource Success}" />
                            <TextBlock Text="Participating actively" Style="{StaticResource MetricSubtext}" />
                        </StackPanel>
                        <Border Grid.Column="1" Width="40" Height="40" CornerRadius="8" Background="{StaticResource SuccessSoft}" VerticalAlignment="Top">
                            <Path Data="{StaticResource GeoCheck}" Fill="{StaticResource Success}" Stretch="Uniform" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>

                <!-- 3. Total Chapters -->
                <Border Style="{StaticResource StatCard}" Width="215" MinWidth="190">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="CHAPTERS" Style="{StaticResource CardLabel}" />
                            <TextBlock Text="{Binding TotalChapters}" Style="{StaticResource MetricValue}" />
                            <TextBlock Text="Active area units" Style="{StaticResource MetricSubtext}" />
                        </StackPanel>
                        <Border Grid.Column="1" Width="40" Height="40" CornerRadius="8" Background="{StaticResource NavySoft}" VerticalAlignment="Top">
                            <Path Data="{StaticResource GeoChapters}" Fill="{StaticResource Navy}" Stretch="Uniform" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>

                <!-- 4. Total Services -->
                <Border Style="{StaticResource StatCard}" Width="215" MinWidth="190">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="SERVICES" Style="{StaticResource CardLabel}" />
                            <TextBlock Text="{Binding TotalServices}" Style="{StaticResource MetricValue}" />
                            <TextBlock Text="Core service pillars" Style="{StaticResource MetricSubtext}" />
                        </StackPanel>
                        <Border Grid.Column="1" Width="40" Height="40" CornerRadius="8" Background="{StaticResource GoldSoft}" VerticalAlignment="Top">
                            <Path Data="{StaticResource GeoServices}" Fill="{StaticResource GoldDark}" Stretch="Uniform" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>

                <!-- 5. Activity Reports -->
                <Border Style="{StaticResource StatCard}" Width="215" MinWidth="190">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="ACTIVITY REPORTS" Style="{StaticResource CardLabel}" />
                            <TextBlock Text="{Binding TotalReports}" Style="{StaticResource MetricValue}" />
                            <TextBlock Text="Filed &amp; documented" Style="{StaticResource MetricSubtext}" />
                        </StackPanel>
                        <Border Grid.Column="1" Width="40" Height="40" CornerRadius="8" Background="{StaticResource ActionBlueSoft}" VerticalAlignment="Top">
                            <Path Data="{StaticResource GeoReports}" Fill="{StaticResource ActionBlue}" Stretch="Uniform" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>

                <!-- 6. Events -->
                <Border Style="{StaticResource StatCard}" Width="215" MinWidth="190">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="EVENTS" Style="{StaticResource CardLabel}" />
                            <TextBlock Text="{Binding TotalEvents}" Style="{StaticResource MetricValue}" />
                            <TextBlock Text="Scheduled &amp; held" Style="{StaticResource MetricSubtext}" />
                        </StackPanel>
                        <Border Grid.Column="1" Width="40" Height="40" CornerRadius="8" Background="{StaticResource WarningSoft}" VerticalAlignment="Top">
                            <Path Data="{StaticResource GeoEvents}" Fill="{StaticResource Warning}" Stretch="Uniform" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>

                <!-- 7. Event Registrations -->
                <Border Style="{StaticResource StatCard}" Width="215" MinWidth="190">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="REGISTRATIONS" Style="{StaticResource CardLabel}" />
                            <TextBlock Text="{Binding EventRegistrations}" Style="{StaticResource MetricValue}" />
                            <TextBlock Text="Total registered seats" Style="{StaticResource MetricSubtext}" />
                        </StackPanel>
                        <Border Grid.Column="1" Width="40" Height="40" CornerRadius="8" Background="{StaticResource NavySoft}" VerticalAlignment="Top">
                            <Path Data="{StaticResource GeoAttendance}" Fill="{StaticResource NavyLight}" Stretch="Uniform" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>

                <!-- 8. Recorded Attendance -->
                <Border Style="{StaticResource StatCard}" Width="215" MinWidth="190">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="RECORDED ATTENDANCE" Style="{StaticResource CardLabel}" />
                            <TextBlock Text="{Binding RecordedAttendance}" Style="{StaticResource MetricValue}" Foreground="{StaticResource NavyMedium}" />
                            <TextBlock Text="Confirmed attendee count" Style="{StaticResource MetricSubtext}" />
                        </StackPanel>
                        <Border Grid.Column="1" Width="40" Height="40" CornerRadius="8" Background="{StaticResource SuccessSoft}" VerticalAlignment="Top">
                            <Path Data="{StaticResource GeoCheck}" Fill="{StaticResource Success}" Stretch="Uniform" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>

            </WrapPanel>

            <!-- Monthly Trend Indicator Card -->
            <Border Style="{StaticResource TrendCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="6" Background="{StaticResource Navy}" Margin="0,0,14,0" VerticalAlignment="Center">
                        <Path Data="{StaticResource GeoTrend}" Fill="{StaticResource Gold}" Stretch="Uniform" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="MONTHLY OPERATIONAL TRENDS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Navy}" Margin="0,0,0,2" />
                        <TextBlock Text="{Binding TrendText}" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" FontSize="12" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Bottom Three Columns / Responsive Sections -->
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Upcoming Events Card -->
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <DockPanel LastChildFill="True">
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                            <TextBlock Text="Upcoming Events" Style="{StaticResource SectionHeader}" Margin="0" VerticalAlignment="Center" />
                        </Grid>

                        <!-- Empty State -->
                        <Border Visibility="{Binding UpcomingEvents, Converter={StaticResource EmptyToVis}}"
                                Padding="16,30" HorizontalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Data="{StaticResource GeoEvents}" Fill="#CBD5E1" Stretch="Uniform" Width="36" Height="36" Margin="0,0,0,10" HorizontalAlignment="Center" />
                                <TextBlock Text="No upcoming events scheduled." Foreground="{StaticResource TextMuted}" FontSize="12" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Events List -->
                        <ItemsControl ItemsSource="{Binding UpcomingEvents}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="2,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding EventName}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <Path Data="{StaticResource GeoLocation}" Fill="{StaticResource TextMuted}" Stretch="Uniform" Width="11" Height="11" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Venue}" Foreground="{StaticResource TextMuted}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="{StaticResource ActionBlueSoft}" CornerRadius="4" Padding="6,3" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding EventDateTime, StringFormat={}{0:MMM d, yyyy}}" Foreground="{StaticResource ActionBlue}" FontSize="11" FontWeight="SemiBold" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>

                <!-- Recent Events Card -->
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <DockPanel LastChildFill="True">
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                            <TextBlock Text="Recent Events" Style="{StaticResource SectionHeader}" Margin="0" VerticalAlignment="Center" />
                        </Grid>

                        <!-- Empty State -->
                        <Border Visibility="{Binding PastEvents, Converter={StaticResource EmptyToVis}}"
                                Padding="16,30" HorizontalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Data="{StaticResource GeoEvents}" Fill="#CBD5E1" Stretch="Uniform" Width="36" Height="36" Margin="0,0,0,10" HorizontalAlignment="Center" />
                                <TextBlock Text="No past events recorded." Foreground="{StaticResource TextMuted}" FontSize="12" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Past Events List -->
                        <ItemsControl ItemsSource="{Binding PastEvents}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="2,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding EventName}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding EventDateTime, StringFormat={}{0:MMM d, yyyy}}" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding RegisteredCount}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                                                <TextBlock Text=" attendees" Foreground="{StaticResource TextMuted}" FontSize="11" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>

                <!-- Members by Chapter Distribution Card -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <DockPanel LastChildFill="True">
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                            <TextBlock Text="Members by Chapter" Style="{StaticResource SectionHeader}" Margin="0" VerticalAlignment="Center" />
                        </Grid>

                        <!-- Empty State -->
                        <Border Visibility="{Binding ChapterDistribution, Converter={StaticResource EmptyToVis}}"
                                Padding="16,30" HorizontalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Data="{StaticResource GeoChapters}" Fill="#CBD5E1" Stretch="Uniform" Width="36" Height="36" Margin="0,0,0,10" HorizontalAlignment="Center" />
                                <TextBlock Text="No chapter records found." Foreground="{StaticResource TextMuted}" FontSize="12" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Chapter Distribution List -->
                        <ItemsControl ItemsSource="{Binding ChapterDistribution}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="2,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding ChapterName}" FontWeight="SemiBold" FontSize="13" />
                                                <TextBlock Text="{Binding ActiveMemberCount, StringFormat={}{0} active members}" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="{StaticResource NavySoft}" CornerRadius="12" Padding="10,3" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding MemberCount, StringFormat={}{0} total}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource Navy}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>

            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
