<UserControl x:Class="MFCYouthAreaManagementSystem.Views.ServicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:MFCYouthAreaManagementSystem.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewmodels:ServicesViewModel}">

    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="Enter" Command="{Binding ViewMembersCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Services" Style="{StaticResource PageTitle}" />
                <TextBlock Text="View the seven core MFC Youth service roles, review active volunteer assignments, and inspect rosters."
                           Style="{StaticResource PageSubtitle}" Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="View Assigned Members"
                        Command="{Binding ViewMembersCommand}"
                        Style="{StaticResource PrimaryButton}" />
            </StackPanel>
        </Grid>

        <!-- Toolbar -->
        <Border Grid.Row="1" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource BorderBrushApp}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,10"
                Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Width="280"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Search service roles..." />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding RefreshCommand}"
                            Style="{StaticResource IconButton}"
                            ToolTip="Refresh list (F5)">
                        <Path Data="{StaticResource GeoRefresh}" Fill="{StaticResource TextSecondary}" Stretch="Uniform" Width="14" Height="14" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Services Presentation DataGrid -->
        <Grid Grid.Row="2">
            <DataGrid ItemsSource="{Binding Services}"
                      SelectedItem="{Binding SelectedService}"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <!-- Service Role Icon & Name -->
                    <DataGridTemplateColumn Header="Service Role" Width="2*" SortMemberPath="ServiceName">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource GoldSoft}" Margin="0,0,12,0">
                                        <Path Data="{StaticResource GeoServices}" Fill="{StaticResource GoldDark}" Stretch="Uniform" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ServiceName}" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Text="Official MFC Youth Service Role" Foreground="{StaticResource TextMuted}" FontSize="11" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Assigned Members Count -->
                    <DataGridTemplateColumn Header="Assigned Members" Width="180" SortMemberPath="MemberCount">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource NavySoft}" CornerRadius="12" Padding="12,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding MemberCount, StringFormat={}{0} members assigned}" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource Navy}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Empty State Overlay -->
            <Border Visibility="{Binding Services, Converter={StaticResource EmptyToVis}}"
                    Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource BorderBrushApp}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <Border Width="52" Height="52" CornerRadius="26" Background="{StaticResource GoldSoft}" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <Path Data="{StaticResource GeoServices}" Fill="{StaticResource GoldDark}" Stretch="Uniform" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="No Services Found" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Navy}" HorizontalAlignment="Center" Margin="0,0,0,4" />
                    <TextBlock Text="No services match your search." Foreground="{StaticResource TextMuted}" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,14" />
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl>
