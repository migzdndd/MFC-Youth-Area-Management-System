<UserControl x:Class="MFCYouthAreaManagementSystem.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:MFCYouthAreaManagementSystem.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewmodels:ReportsViewModel}">

    <UserControl.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding AddCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="Delete" Command="{Binding DeleteCommand}" />
        <KeyBinding Key="E" Modifiers="Control+Shift" Command="{Binding ExportCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" MinHeight="160" />
            <RowDefinition Height="2*" MinHeight="140" />
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Activity Reports" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Create, filter, analyze, link, and export official Activity Reports."
                           Style="{StaticResource PageSubtitle}" Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Export PDF"
                        Command="{Binding ExportCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0" />

                <Button Content="+ Add Report"
                        Command="{Binding AddCommand}"
                        Style="{StaticResource PrimaryButton}" />
            </StackPanel>
        </Grid>

        <!-- Filter Bar -->
        <Border Grid.Row="1" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource BorderBrushApp}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,10"
                Margin="0,0,0,10">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Search Input -->
                <TextBox Width="210"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,8,0"
                         ToolTip="Search by report title, content, or author..." />

                <!-- Chapter Filter -->
                <ComboBox Width="180"
                          ItemsSource="{Binding ChapterOptions}"
                          DisplayMemberPath="DisplayName"
                          SelectedItem="{Binding SelectedChapter}"
                          Margin="0,0,8,0" />

                <!-- Report Type Filter -->
                <ComboBox Width="160"
                          ItemsSource="{Binding ReportTypes}"
                          SelectedItem="{Binding SelectedReportType}"
                          Margin="0,0,8,0" />

                <!-- Date Range Filters -->
                <DatePicker Width="135"
                            SelectedDate="{Binding DateFrom}"
                            ToolTip="Filter starting date"
                            Margin="0,0,8,0" />

                <DatePicker Width="135"
                            SelectedDate="{Binding DateTo}"
                            ToolTip="Filter ending date"
                            Margin="0,0,8,0" />

                <Button Content="Clear Filters"
                        Command="{Binding ClearFiltersCommand}"
                        Style="{StaticResource GhostButton}" />
            </WrapPanel>
        </Border>

        <!-- Action / Summary Bar -->
        <Grid Grid.Row="2" Margin="2,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Summary Pill -->
            <Border Background="{StaticResource NavySoft}" CornerRadius="12" Padding="10,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Text="{Binding Summary}" Foreground="{StaticResource Navy}" FontSize="11" FontWeight="SemiBold" />
            </Border>

            <!-- Row Context Actions -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Edit"
                        Command="{Binding EditCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Padding="12,5" />

                <Button Content="Delete"
                        Command="{Binding DeleteCommand}"
                        Style="{StaticResource DangerButton}"
                        Padding="12,5" />

                <Button Command="{Binding RefreshCommand}"
                        Style="{StaticResource IconButton}"
                        ToolTip="Refresh reports (F5)">
                    <Path Data="{StaticResource GeoRefresh}" Fill="{StaticResource TextSecondary}" Stretch="Uniform" Width="14" Height="14" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Reports DataGrid -->
        <Grid Grid.Row="3" Margin="0,0,0,10">
            <DataGrid ItemsSource="{Binding Reports}"
                      SelectedItem="{Binding SelectedReport}"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <!-- Date -->
                    <DataGridTextColumn Header="Date" Binding="{Binding ReportDate, StringFormat={}{0:MMM d, yyyy}}" Width="115" />

                    <!-- Title -->
                    <DataGridTemplateColumn Header="Report Title" Width="2*" SortMemberPath="Title">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Chapter -->
                    <DataGridTextColumn Header="Chapter" Binding="{Binding ChapterName}" Width="*" />

                    <!-- Report Type Badge -->
                    <DataGridTemplateColumn Header="Report Type" Width="140" SortMemberPath="ReportType">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource GoldSoft}"
                                        BorderBrush="{StaticResource GoldLight}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="8,2"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ReportType}"
                                               Foreground="{StaticResource GoldDark}"
                                               FontSize="11"
                                               FontWeight="SemiBold" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Linked Event -->
                    <DataGridTemplateColumn Header="Linked Event" Width="1.5*" SortMemberPath="EventName">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding EventName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Prepared By -->
                    <DataGridTextColumn Header="Prepared By" Binding="{Binding PreparedBy}" Width="150" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- Empty State Overlay -->
            <Border Visibility="{Binding Reports, Converter={StaticResource EmptyToVis}}"
                    Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource BorderBrushApp}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <Border Width="52" Height="52" CornerRadius="26" Background="{StaticResource ActionBlueSoft}" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <Path Data="{StaticResource GeoReports}" Fill="{StaticResource ActionBlue}" Stretch="Uniform" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="No Activity Reports Found" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Navy}" HorizontalAlignment="Center" Margin="0,0,0,4" />
                    <TextBlock Text="No reports match your current filters." Foreground="{StaticResource TextMuted}" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,14" />
                    <Button Content="Clear Filters" Command="{Binding ClearFiltersCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Bottom Analytics Cards -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 6-Month Volume Card -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,6,0">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top" Text="6-Month Activity Volume" Style="{StaticResource SectionHeader}" FontSize="14" Margin="0,0,0,8" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding MonthlyAnalytics}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="32" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                                        <ProgressBar Grid.Column="1" Value="{Binding Percentage}" Maximum="100" Height="8" Margin="4,0" Foreground="{StaticResource ActionBlue}" Background="{StaticResource SurfaceSubtle}" BorderThickness="0" />
                                        <TextBlock Grid.Column="2" Text="{Binding Count}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Report Type Mix Card -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="4,0,4,0">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top" Text="Report Type Breakdown" Style="{StaticResource SectionHeader}" FontSize="14" Margin="0,0,0,8" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding TypeAnalytics}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                                        <Border Grid.Column="1" Background="{StaticResource GoldSoft}" CornerRadius="10" Padding="8,2">
                                            <TextBlock Text="{Binding Count}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource GoldDark}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Chapter Activity Card -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="6,0,0,0">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top" Text="Chapter Report Distribution" Style="{StaticResource SectionHeader}" FontSize="14" Margin="0,0,0,8" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ChapterAnalytics}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <Border Grid.Column="1" Background="{StaticResource NavySoft}" CornerRadius="10" Padding="8,2">
                                            <TextBlock Text="{Binding Count}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource Navy}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

        </Grid>

    </Grid>
</UserControl>
