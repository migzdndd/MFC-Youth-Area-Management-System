<Window x:Class="MFCYouthAreaManagementSystem.Views.Dialogs.ChapterEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chapter"
        Width="460"
        Height="280"
        MinWidth="380"
        MinHeight="260"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PageBackground}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource DialogHeaderBorder}">
            <StackPanel>
                <TextBlock x:Name="Heading" Text="Chapter" Style="{StaticResource PageTitle}" FontSize="18" />
                <TextBlock Text="Enter the official chapter designation name."
                           Style="{StaticResource HelperText}" Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <!-- Form Body -->
        <Border Grid.Row="1" Style="{StaticResource FormSectionCard}" Margin="20,16">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Chapter Name *" Style="{StaticResource FormLabel}" Margin="0,0,0,4" />
                <TextBox x:Name="NameBox" ToolTip="e.g. Chapter 1, MFC High, Campus" />
            </StackPanel>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="2" Style="{StaticResource DialogFooterBorder}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Style="{StaticResource SecondaryButton}"
                        Click="Cancel_Click"
                        Margin="0,0,8,0" />

                <Button Content="Save Chapter"
                        Style="{StaticResource PrimaryButton}"
                        Click="Save_Click" />
            </StackPanel>
        </Border>

    </Grid>
</Window>
