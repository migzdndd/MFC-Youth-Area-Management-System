<Window x:Class="MFCYouthAreaManagementSystem.Views.Dialogs.ParticipantEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Participant Registration"
        Width="680"
        Height="700"
        MinWidth="560"
        MinHeight="580"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PageBackground}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource DialogHeaderBorder}">
            <StackPanel>
                <TextBlock x:Name="Heading" Text="Register Participant" Style="{StaticResource PageTitle}" FontSize="20" />
                <TextBlock Text="Enter event participant details, chapter, service role, and payment status."
                           Style="{StaticResource HelperText}" Margin="0,3,0,0" />
            </StackPanel>
        </Border>

        <!-- Form Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,18">

                <!-- 1. Personal Information -->
                <Border Style="{StaticResource FormSectionCard}">
                    <StackPanel>
                        <TextBlock Text="Personal Information" Style="{StaticResource SectionHeader}" FontSize="15" Margin="0,0,0,12" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="First Name *" Style="{StaticResource FormLabel}" />
                                <TextBox x:Name="FirstBox" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="4,0,8,0">
                                <TextBlock Text="M.I." Style="{StaticResource FormLabel}" />
                                <TextBox x:Name="MiddleBox" MaxLength="2" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                <TextBlock Text="Last Name *" Style="{StaticResource FormLabel}" />
                                <TextBox x:Name="LastBox" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Age *" Style="{StaticResource FormLabel}" />
                                <TextBox x:Name="AgeBox" ToolTip="Attendee age (e.g., 18)" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="Contact Number *" Style="{StaticResource FormLabel}" />
                                <TextBox x:Name="ContactBox" MaxLength="11" ToolTip="11-digit mobile number" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 2. Event Registration, Payment & Attendance -->
                <Border Style="{StaticResource FormSectionCard}">
                    <StackPanel>
                        <TextBlock Text="Event Alignment, Payment &amp; Attendance" Style="{StaticResource SectionHeader}" FontSize="15" Margin="0,0,0,12" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Chapter *" Style="{StaticResource FormLabel}" />
                                <ComboBox x:Name="ChapterCombo" DisplayMemberPath="ChapterName" />

                                <TextBlock Text="Payment Status *" Style="{StaticResource FormLabel}" />
                                <ComboBox x:Name="StatusCombo" SelectionChanged="StatusCombo_SelectionChanged" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="Service Role *" Style="{StaticResource FormLabel}" />
                                <ComboBox x:Name="ServiceCombo" DisplayMemberPath="ServiceName" />

                                <TextBlock Text="Mode of Payment" Style="{StaticResource FormLabel}" />
                                <ComboBox x:Name="ModeCombo" />
                            </StackPanel>
                        </Grid>

                        <CheckBox x:Name="AttendedCheck"
                                  Content="Mark as Recorded Attendance (Confirmed Present at Venue)"
                                  Margin="0,10,0,10"
                                  FontWeight="SemiBold"
                                  Foreground="{StaticResource Navy}" />

                        <TextBlock Text="Address *" Style="{StaticResource FormLabel}" />
                        <TextBox x:Name="AddressBox" Height="65" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer Actions -->
        <Border Grid.Row="2" Style="{StaticResource DialogFooterBorder}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Style="{StaticResource SecondaryButton}"
                        Click="Cancel_Click"
                        Margin="0,0,8,0" />

                <Button Content="Save Participant"
                        Style="{StaticResource PrimaryButton}"
                        Click="Save_Click" />
            </StackPanel>
        </Border>

    </Grid>
</Window>
