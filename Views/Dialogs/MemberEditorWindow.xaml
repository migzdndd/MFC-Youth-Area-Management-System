<Window x:Class="MFCYouthAreaManagementSystem.Views.Dialogs.MemberEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Member"
        Width="680"
        Height="720"
        MinWidth="560"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PageBackground}">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Dialog Header -->
            <RowDefinition Height="Auto" />
            <!-- Scrollable Content -->
            <RowDefinition Height="*" />
            <!-- Action Footer -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource DialogHeaderBorder}">
            <StackPanel>
                <TextBlock x:Name="Heading" Text="Member" Style="{StaticResource PageTitle}" FontSize="20" />
                <TextBlock Text="Enter personal details, contact coordinates, and chapter alignment."
                           Style="{StaticResource HelperText}" Margin="0,3,0,0" />
            </StackPanel>
        </Border>

        <!-- Form Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,18">

                <!-- 1. Personal Information Section -->
                <Border Style="{StaticResource FormSectionCard}">
                    <StackPanel>
                        <TextBlock Text="Personal Information" Style="{StaticResource SectionHeader}" FontSize="15" Margin="0,0,0,12" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="First Name *" Style="{StaticResource FormLabel}" />
                                <TextBox x:Name="FirstNameBox" />

                                <TextBlock Text="Middle Name" Style="{StaticResource FormLabel}" />
                                <TextBox x:Name="MiddleNameBox" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="Last Name *" Style="{StaticResource FormLabel}" />
                                <TextBox x:Name="LastNameBox" />

                                <TextBlock Text="Birth Date *" Style="{StaticResource FormLabel}" />
                                <DatePicker x:Name="BirthDatePicker" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 2. Contact & Address Section -->
                <Border Style="{StaticResource FormSectionCard}">
                    <StackPanel>
                        <TextBlock Text="Contact Information" Style="{StaticResource SectionHeader}" FontSize="15" Margin="0,0,0,12" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Contact Number *" Style="{StaticResource FormLabel}" />
                                <TextBox x:Name="ContactBox" MaxLength="11" ToolTip="11-digit mobile number (e.g., 09171234567)" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="Email Address" Style="{StaticResource FormLabel}" />
                                <TextBox x:Name="EmailBox" ToolTip="Valid email address" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Complete Address *" Style="{StaticResource FormLabel}" />
                        <TextBox x:Name="AddressBox" Height="70" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </Border>

                <!-- 3. Chapter & Status Section -->
                <Border Style="{StaticResource FormSectionCard}">
                    <StackPanel>
                        <TextBlock Text="Chapter Alignment &amp; Status" Style="{StaticResource SectionHeader}" FontSize="15" Margin="0,0,0,12" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Chapter" Style="{StaticResource FormLabel}" />
                                <ComboBox x:Name="ChapterCombo" DisplayMemberPath="ChapterName" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="Membership Status *" Style="{StaticResource FormLabel}" />
                                <ComboBox x:Name="StatusCombo" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer Actions -->
        <Border Grid.Row="2" Style="{StaticResource DialogFooterBorder}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Style="{StaticResource SecondaryButton}"
                        Click="Cancel_Click"
                        Margin="0,0,8,0" />

                <Button Content="Save Member"
                        Style="{StaticResource PrimaryButton}"
                        Click="Save_Click" />
            </StackPanel>
        </Border>

    </Grid>
</Window>
