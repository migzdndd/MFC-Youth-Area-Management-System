<Window x:Class="MFCYouthAreaManagementSystem.Views.Dialogs.GigTrackerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GIG Tracker"
        Width="750"
        Height="600"
        MinWidth="640"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PageBackground}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource DialogHeaderBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="GIG Contribution Tracker" Style="{StaticResource PageTitle}" FontSize="20" />
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="Member: " Foreground="{StaticResource TextMuted}" FontSize="12" />
                        <TextBlock x:Name="MemberText" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource Navy}" />
                    </StackPanel>
                </StackPanel>

                <!-- Prominent Total Pill -->
                <Border Grid.Column="1" Background="{StaticResource GoldSoft}" BorderBrush="{StaticResource GoldLight}" BorderThickness="1" CornerRadius="8" Padding="16,8" VerticalAlignment="Center">
                    <TextBlock x:Name="TotalText" FontSize="18" FontWeight="Bold" Foreground="{StaticResource GoldDark}" />
                </Border>
            </Grid>
        </Border>

        <!-- Action Toolbar -->
        <Border Grid.Row="1" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource BorderBrushApp}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="+ Add Contribution"
                        Style="{StaticResource PrimaryButton}"
                        Click="Add_Click"
                        Margin="0,0,8,0" />

                <Button Content="Edit"
                        Style="{StaticResource SecondaryButton}"
                        Click="Edit_Click"
                        Margin="0,0,8,0" />

                <Button Content="Delete"
                        Style="{StaticResource DangerButton}"
                        Click="Delete_Click" />
            </StackPanel>
        </Border>

        <!-- History DataGrid -->
        <Grid Grid.Row="2" Margin="24,16">
            <DataGrid x:Name="Grid" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Contribution Date" Binding="{Binding ContributionDate, StringFormat={}{0:MMM d, yyyy}}" Width="180" />
                    <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=₱{0:N2}}" Width="150" />
                    <DataGridTextColumn Header="Remarks" Binding="{Binding Remarks}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="3" Style="{StaticResource DialogFooterBorder}">
            <Button Content="Close"
                    HorizontalAlignment="Right"
                    Style="{StaticResource SecondaryButton}"
                    Click="Close_Click" />
        </Border>

    </Grid>
</Window>
