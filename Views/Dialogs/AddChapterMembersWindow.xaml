<Window x:Class="MFCYouthAreaManagementSystem.Views.Dialogs.AddChapterMembersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Members"
        Width="640"
        Height="600"
        MinWidth="520"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PageBackground}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource DialogHeaderBorder}">
            <StackPanel>
                <TextBlock Text="Add Members to Chapter" Style="{StaticResource PageTitle}" FontSize="20" />
                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                    <TextBlock Text="Target Chapter: " Foreground="{StaticResource TextMuted}" FontSize="12" />
                    <TextBlock x:Name="ChapterText" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource Navy}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Search Toolbar -->
        <Border Grid.Row="1" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource BorderBrushApp}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <TextBox x:Name="SearchBox"
                     TextChanged="SearchBox_TextChanged"
                     Width="280"
                     HorizontalAlignment="Left"
                     ToolTip="Search unassigned members by name or contact..." />
        </Border>

        <!-- Unassigned Members Selection List -->
        <Grid Grid.Row="2" Margin="24,16">
            <ListBox x:Name="MemberList" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrushApp}" BorderThickness="1">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding IsSelected}" Margin="6,4">
                            <StackPanel Margin="6,0,0,0">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="{Binding Contact}" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,2,0,0" />
                            </StackPanel>
                        </CheckBox>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="3" Style="{StaticResource DialogFooterBorder}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Style="{StaticResource SecondaryButton}"
                        Click="Cancel_Click"
                        Margin="0,0,8,0" />

                <Button Content="Add Selected Members"
                        Style="{StaticResource PrimaryButton}"
                        Click="Save_Click" />
            </StackPanel>
        </Border>

    </Grid>
</Window>
