<Window x:Class="MFCYouthAreaManagementSystem.Views.Dialogs.EventDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Event Details"
        Width="960"
        Height="720"
        MinWidth="800"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PageBackground}">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto" />
            <!-- 4 Stat Cards -->
            <RowDefinition Height="Auto" />
            <!-- Toolbar -->
            <RowDefinition Height="Auto" />
            <!-- DataGrid -->
            <RowDefinition Height="*" />
            <!-- Footer -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header Card -->
        <Border Grid.Row="0" Style="{StaticResource DialogHeaderBorder}">
            <StackPanel>
                <TextBlock x:Name="Heading" Style="{StaticResource PageTitle}" FontSize="22" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                    <Path Data="{StaticResource GeoClock}" Fill="{StaticResource TextMuted}" Stretch="Uniform" Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="MetaText" Style="{StaticResource CardLabel}" FontSize="12" VerticalAlignment="Center" Margin="0" />
                </StackPanel>
                <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" FontSize="13" />
            </StackPanel>
        </Border>

        <!-- 4 Metric Cards -->
        <Border Grid.Row="1" Margin="24,12,24,0">
            <UniformGrid Columns="4">
                <!-- Registered -->
                <Border Style="{StaticResource StatCard}" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="REGISTERED" Style="{StaticResource CardLabel}" />
                        <TextBlock x:Name="RegisteredText" Style="{StaticResource MetricValue}" />
                    </StackPanel>
                </Border>

                <!-- Attended -->
                <Border Style="{StaticResource StatCard}" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Text="ATTENDED" Style="{StaticResource CardLabel}" />
                        <TextBlock x:Name="AttendedText" Style="{StaticResource MetricValue}" Foreground="{StaticResource Success}" />
                    </StackPanel>
                </Border>

                <!-- Paid -->
                <Border Style="{StaticResource StatCard}" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Text="PAID SEATS" Style="{StaticResource CardLabel}" />
                        <TextBlock x:Name="PaidText" Style="{StaticResource MetricValue}" Foreground="{StaticResource ActionBlue}" />
                    </StackPanel>
                </Border>

                <!-- Collected -->
                <Border Style="{StaticResource StatCard}" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="TOTAL COLLECTED" Style="{StaticResource CardLabel}" />
                        <TextBlock x:Name="CollectedText" Style="{StaticResource MetricValue}" Foreground="{StaticResource GoldDark}" />
                    </StackPanel>
                </Border>
            </UniformGrid>
        </Border>

        <!-- Toolbar -->
        <Border Grid.Row="2" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource BorderBrushApp}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,10"
                Margin="24,12,24,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchBox"
                         Width="260"
                         ToolTip="Search participants by name, chapter, or service..." />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="+ Register Participant"
                            Style="{StaticResource PrimaryButton}"
                            Click="Add_Click"
                            Margin="0,0,8,0" />

                    <Button Content="Edit"
                            Style="{StaticResource SecondaryButton}"
                            Click="Edit_Click"
                            Margin="0,0,8,0" />

                    <Button Content="Delete"
                            Style="{StaticResource DangerButton}"
                            Click="Delete_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Participants DataGrid -->
        <Grid Grid.Row="3" Margin="24,0,24,12">
            <DataGrid x:Name="Grid" SelectionMode="Single">
                <DataGrid.Columns>
                    <!-- Participant Name -->
                    <DataGridTemplateColumn Header="Participant Name" Width="2*" SortMemberPath="FullName">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Age -->
                    <DataGridTextColumn Header="Age" Binding="{Binding Age}" Width="65" />

                    <!-- Chapter -->
                    <DataGridTextColumn Header="Chapter" Binding="{Binding ChapterName}" Width="*" />

                    <!-- Service -->
                    <DataGridTextColumn Header="Service Role" Binding="{Binding ServiceName}" Width="*" />

                    <!-- Payment Status -->
                    <DataGridTemplateColumn Header="Payment" Width="105" SortMemberPath="PaymentStatus">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding PaymentStatus, Converter={StaticResource StatusToBg}}"
                                        BorderBrush="{Binding PaymentStatus, Converter={StaticResource StatusToBorder}}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="8,2"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PaymentStatus}"
                                               Foreground="{Binding PaymentStatus, Converter={StaticResource StatusToFg}}"
                                               FontSize="11"
                                               FontWeight="SemiBold" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Mode of Payment -->
                    <DataGridTextColumn Header="Payment Mode" Binding="{Binding ModeOfPayment}" Width="120" />

                    <!-- Attendance Check -->
                    <DataGridCheckBoxColumn Header="Attended" Binding="{Binding Attended}" Width="90" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="4" Style="{StaticResource DialogFooterBorder}">
            <Button Content="Close"
                    HorizontalAlignment="Right"
                    Style="{StaticResource SecondaryButton}"
                    Click="Close_Click" />
        </Border>

    </Grid>
</Window>
