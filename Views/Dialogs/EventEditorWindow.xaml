<Window x:Class="MFCYouthAreaManagementSystem.Views.Dialogs.EventEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Event"
        Width="680"
        Height="640"
        MinWidth="560"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PageBackground}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource DialogHeaderBorder}">
            <StackPanel>
                <TextBlock x:Name="Heading" Text="Event Information" Style="{StaticResource PageTitle}" FontSize="20" />
                <TextBlock Text="Enter event schedule details, venue location, and optional registration fee."
                           Style="{StaticResource HelperText}" Margin="0,3,0,0" />
            </StackPanel>
        </Border>

        <!-- Form Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,18">

                <!-- 1. Schedule & Venue Section -->
                <Border Style="{StaticResource FormSectionCard}">
                    <StackPanel>
                        <TextBlock Text="Event Schedule &amp; Venue" Style="{StaticResource SectionHeader}" FontSize="15" Margin="0,0,0,12" />

                        <TextBlock Text="Event Name *" Style="{StaticResource FormLabel}" Margin="0,0,0,4" />
                        <TextBox x:Name="NameBox" />

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Event Date *" Style="{StaticResource FormLabel}" />
                                <DatePicker x:Name="DatePicker" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="Time (HH:mm, 24h) *" Style="{StaticResource FormLabel}" />
                                <TextBox x:Name="TimeBox" ToolTip="Format: 19:00 or 08:30" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Venue / Location *" Style="{StaticResource FormLabel}" Margin="0,6,0,4" />
                        <TextBox x:Name="VenueBox" ToolTip="Physical or virtual venue address" />

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Registration Fee (₱)" Style="{StaticResource FormLabel}" />
                                <TextBox x:Name="FeeBox" ToolTip="Leave empty or enter 0 for free events" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="People Attended (Legacy count)" Style="{StaticResource FormLabel}" />
                                <TextBox x:Name="PeopleBox" Text="0" ToolTip="Manual / legacy headcount" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 2. Description Section -->
                <Border Style="{StaticResource FormSectionCard}">
                    <StackPanel>
                        <TextBlock Text="Event Description &amp; Theme" Style="{StaticResource SectionHeader}" FontSize="15" Margin="0,0,0,12" />
                        <TextBlock Text="Full Description *" Style="{StaticResource FormLabel}" Margin="0,0,0,4" />
                        <TextBox x:Name="DescriptionBox" Height="100" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer Actions -->
        <Border Grid.Row="2" Style="{StaticResource DialogFooterBorder}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Style="{StaticResource SecondaryButton}"
                        Click="Cancel_Click"
                        Margin="0,0,8,0" />

                <Button Content="Save Event"
                        Style="{StaticResource PrimaryButton}"
                        Click="Save_Click" />
            </StackPanel>
        </Border>

    </Grid>
</Window>
