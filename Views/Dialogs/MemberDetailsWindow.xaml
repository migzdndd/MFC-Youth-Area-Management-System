<Window x:Class="MFCYouthAreaManagementSystem.Views.Dialogs.MemberDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Member Profile"
        Width="700"
        Height="680"
        MinWidth="580"
        MinHeight="580"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PageBackground}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource DialogHeaderBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Width="46" Height="46" CornerRadius="23" Background="{StaticResource NavySoft}" Margin="0,0,14,0" VerticalAlignment="Center">
                    <Path Data="{StaticResource GeoMembers}" Fill="{StaticResource Navy}" Stretch="Uniform" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="NameText" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Navy}" />
                    <TextBlock x:Name="MetaText" Style="{StaticResource HelperText}" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,18">

                <!-- Member Info Card -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left Column: Contact & Address -->
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Contact Number" Style="{StaticResource CardLabel}" />
                            <TextBlock x:Name="ContactText" FontSize="13" Margin="0,0,0,12" />

                            <TextBlock Text="Email Address" Style="{StaticResource CardLabel}" />
                            <TextBlock x:Name="EmailText" FontSize="13" Margin="0,0,0,12" />

                            <TextBlock Text="Complete Address" Style="{StaticResource CardLabel}" />
                            <TextBlock x:Name="AddressText" FontSize="13" TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Right Column: Chapter & Services -->
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Text="Assigned Chapter" Style="{StaticResource CardLabel}" />
                            <TextBlock x:Name="ChapterText" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,12" />

                            <TextBlock Text="Assigned Services" Style="{StaticResource CardLabel}" />
                            <TextBlock x:Name="ServicesText" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,12" />

                            <TextBlock Text="Total GIG Contributions" Style="{StaticResource CardLabel}" />
                            <Border Background="{StaticResource GoldSoft}" BorderBrush="{StaticResource GoldLight}" BorderThickness="1" CornerRadius="8" Padding="12,6" HorizontalAlignment="Left">
                                <TextBlock x:Name="GigTotalText" FontSize="18" FontWeight="Bold" Foreground="{StaticResource GoldDark}" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Recent GIG Section -->
                <TextBlock Text="Recent GIG Contributions" Style="{StaticResource SectionHeader}" FontSize="15" Margin="0,4,0,8" />

                <Border Style="{StaticResource Card}" Padding="0" Margin="0">
                    <DataGrid x:Name="GigGrid" Height="200">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Contribution Date" Binding="{Binding ContributionDate, StringFormat={}{0:MMM d, yyyy}}" Width="150" />
                            <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=₱{0:N2}}" Width="130" />
                            <DataGridTextColumn Header="Remarks" Binding="{Binding Remarks}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Style="{StaticResource DialogFooterBorder}">
            <Button Content="Close"
                    HorizontalAlignment="Right"
                    Style="{StaticResource SecondaryButton}"
                    Click="Close_Click" />
        </Border>

    </Grid>
</Window>
