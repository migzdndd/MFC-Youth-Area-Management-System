<Window x:Class="MFCYouthAreaManagementSystem.Views.Dialogs.ServiceAssignmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Assign Services"
        Width="500"
        Height="540"
        MinWidth="420"
        MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PageBackground}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource DialogHeaderBorder}">
            <StackPanel>
                <TextBlock Text="Assign Service Roles" Style="{StaticResource PageTitle}" FontSize="20" />
                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                    <TextBlock Text="Member: " Foreground="{StaticResource TextMuted}" FontSize="12" />
                    <TextBlock x:Name="MemberText" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource Navy}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Services Selection List -->
        <Border Grid.Row="1" Style="{StaticResource FormSectionCard}" Margin="24,16">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Top" Text="Check all applicable service ministries:" Style="{StaticResource CardLabel}" Margin="0,0,0,10" />
                <ListBox x:Name="ServicesList" Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected}" Margin="6,5">
                                <StackPanel Orientation="Horizontal" Margin="6,0,0,0">
                                    <Border Width="26" Height="26" CornerRadius="6" Background="{StaticResource GoldSoft}" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Path Data="{StaticResource GeoServices}" Fill="{StaticResource GoldDark}" Stretch="Uniform" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="2" Style="{StaticResource DialogFooterBorder}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Style="{StaticResource SecondaryButton}"
                        Click="Cancel_Click"
                        Margin="0,0,8,0" />

                <Button Content="Save Assignments"
                        Style="{StaticResource PrimaryButton}"
                        Click="Save_Click" />
            </StackPanel>
        </Border>

    </Grid>
</Window>
